COHERE_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

LLM_PROVIDER=openrouter
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional app attribution in the OpenRouter dashboard:
# OPENROUTER_APP_NAME=manila-memory
# OPENROUTER_APP_URL=http://localhost:3000
# Optional per-stage overrides:
# OPENROUTER_FILTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_EXTRACT_MODEL=google/gemini-2.5-flash
# OPENROUTER_CONSOLIDATE_MODEL=google/gemini-2.5-flash
# OPENROUTER_SUMMARIZE_MODEL=google/gemini-2.5-flash
# OPENROUTER_GRAPH_MODEL=google/gemini-2.5-flash
# OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash

DB_PATH=./data/memory.db
SESSION_PATH=./data/session

LOG_LEVEL=info
